SAVEMYCONTEXT_DEBUG=false
SAVEMYCONTEXT_DATABASE_URL=sqlite+aiosqlite:///./data/savemycontext.db
SAVEMYCONTEXT_MARKDOWN_DIR=./data/markdown
SAVEMYCONTEXT_LLM_BACKEND=none
SAVEMYCONTEXT_OPENAI_API_KEY=
SAVEMYCONTEXT_OPENAI_MODEL=gpt-5-mini
SAVEMYCONTEXT_GOOGLE_API_KEY=
SAVEMYCONTEXT_GOOGLE_MODEL=gemini-2.5-flash
SAVEMYCONTEXT_REQUEST_TIMEOUT_SECONDS=30
SAVEMYCONTEXT_MAX_REQUEST_BODY_BYTES=26214400

# SQLite is authoritative; one process runs the durable background worker.
SAVEMYCONTEXT_WORKSPACE_ENABLED=true
SAVEMYCONTEXT_WORKSPACE_WORKER=true
# No capture leaves this host unless explicitly enabled below.
SAVEMYCONTEXT_WORKSPACE_EXTERNAL_PROCESSING=false
SAVEMYCONTEXT_WORKSPACE_GENERATE=false
SAVEMYCONTEXT_JEV_API_KEY=
SAVEMYCONTEXT_JEV_MODEL=typesafe/jev-1.13
# Optional directory of protected per-client bearer-token files.
# SAVEMYCONTEXT_WORKSPACE_TOKEN_DIR=/etc/savemycontext/tokens
