{
  "name": "@savemycontext/ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Standalone and embeddable SaveMyContext workspace, with no runtime framework dependency",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./src/workspace.d.ts", "default": "./src/workspace.js" },
    "./embed": { "types": "./src/embed.d.ts", "default": "./src/embed.js" },
    "./workspace.css": "./src/workspace.css"
  },
  "files": ["src"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:backend": "node scripts/build.mjs --backend",
    "check:backend": "node scripts/build.mjs --check-backend",
    "test": "node --test tests/*.test.mjs"
  }
}
